<Window x:Class="Catcretary.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catcretary"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">

    <Grid x:Name="Root" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseRightButtonUp="Root_MouseRightButtonUp"
          MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Grid.RenderTransform>
            <TransformGroup>
                <!-- 좌우 반전(걷는 방향) 과 점프(Y) 를 따로 애니메이션한다. -->
                <ScaleTransform x:Name="FaceFlip" ScaleX="1"/>
                <TranslateTransform x:Name="Hop"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- 실제 스프라이트. 픽셀아트라 보간 없이 확대한다. -->
        <Image x:Name="Sprite" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               SnapsToDevicePixels="True" Visibility="Collapsed"/>

        <!-- 에셋이 없을 때 그리는 임시 고양이. 스프라이트가 로드되면 숨긴다. -->
        <Canvas x:Name="Placeholder" Width="128" Height="128">
            <Polygon Points="30,58 44,22 62,56" Fill="#F2A65A"/>
            <Polygon Points="66,56 84,22 98,58" Fill="#F2A65A"/>
            <Polygon Points="38,56 46,34 56,55" Fill="#F9C9A3"/>
            <Polygon Points="72,55 82,34 90,56" Fill="#F9C9A3"/>
            <Ellipse Canvas.Left="20" Canvas.Top="48" Width="88" Height="72" Fill="#F2A65A"/>
            <Ellipse Canvas.Left="40" Canvas.Top="86" Width="48" Height="26" Fill="#FCE3CF"/>
            <Ellipse x:Name="EyeL" Canvas.Left="44" Canvas.Top="70" Width="10" Height="14" Fill="#2B2B2B"/>
            <Ellipse x:Name="EyeR" Canvas.Left="74" Canvas.Top="70" Width="10" Height="14" Fill="#2B2B2B"/>
            <Rectangle x:Name="BlinkL" Canvas.Left="43" Canvas.Top="76" Width="12" Height="3" Fill="#2B2B2B" Visibility="Collapsed"/>
            <Rectangle x:Name="BlinkR" Canvas.Left="73" Canvas.Top="76" Width="12" Height="3" Fill="#2B2B2B" Visibility="Collapsed"/>
            <Polygon Points="60,88 68,88 64,93" Fill="#D9776B"/>
            <Path Data="M58,95 Q64,100 70,95" Stroke="#2B2B2B" StrokeThickness="1.5"/>
            <Line X1="22" Y1="88" X2="44" Y2="92" Stroke="#2B2B2B" StrokeThickness="1"/>
            <Line X1="22" Y1="98" X2="44" Y2="96" Stroke="#2B2B2B" StrokeThickness="1"/>
            <Line X1="84" Y1="92" X2="106" Y2="88" Stroke="#2B2B2B" StrokeThickness="1"/>
            <Line X1="84" Y1="96" X2="106" Y2="98" Stroke="#2B2B2B" StrokeThickness="1"/>
            <TextBlock x:Name="ThinkDots" Canvas.Left="96" Canvas.Top="30" Text="…" FontSize="26" FontWeight="Bold"
                       Foreground="#2B2B2B" Visibility="Collapsed"/>
        </Canvas>

        <!-- 지연 항목이 있을 때 붙는 배지. 반전돼도 글자가 뒤집히지 않게 자기 자신도 반전한다. -->
        <Border x:Name="AlertBadge" Width="26" Height="26" CornerRadius="13" Background="#DC2626"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BadgeFlip" ScaleX="1"/>
            </Border.RenderTransform>
            <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
        </Border>
    </Grid>
</Window>
