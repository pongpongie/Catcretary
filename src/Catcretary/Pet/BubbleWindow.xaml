<Window x:Class="Catcretary.Pet.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Catcretary.Views"
        Title="말풍선"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" ShowActivated="False"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <v:HexToBrushConverter x:Key="HexToBrush"/>
        <v:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>

        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <DataTemplate x:Key="ItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="done" Grid.Column="0" Width="22" Height="22" Padding="0" FontSize="12"
                        Style="{StaticResource Flat}" Content="✓" ToolTip="완료 처리"
                        IsEnabled="{Binding CanComplete}" Click="Complete_Click" Tag="{Binding}"/>
                <!-- 완료 버튼을 뺀 나머지 줄을 누르면 Plane 페이지를 연다. -->
                <Border x:Name="row" Grid.Column="1" Background="Transparent" Cursor="Hand"
                        ToolTip="Plane 에서 열기" Tag="{Binding}" MouseLeftButtonUp="Item_MouseLeftButtonUp">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Key}" Margin="8,0,0,0" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                   FontFamily="Consolas, Segoe UI"/>
                        <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Name}" Margin="8,0,8,0" FontSize="12.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        <TextBlock x:Name="due" Grid.Column="2" Text="{Binding DueText}" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                    </Grid>
                    <!-- 지난 브리핑 이후 남이 남긴 댓글·변경 -->
                    <TextBlock Text="{Binding NoticeText}" FontSize="11" Margin="8,1,0,0" Foreground="#059669"
                               TextTrimming="CharacterEllipsis" MaxWidth="340" HorizontalAlignment="Left"
                               Visibility="{Binding NoticeText, Converter={StaticResource EmptyToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="title" Property="TextDecorations" Value="Underline"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="due" Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="title" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="done" Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="done" Property="Content" Value="…"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                               Fill="{Binding Accent, Converter={StaticResource HexToBrush}}"/>
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding CountText}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemTemplate}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- 그림자 여백을 두기 위한 바깥 Grid. 카드 바깥은 투명이라 클릭이 통과한다. -->
    <Grid Margin="14">
        <Border x:Name="Card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="14" Padding="14,11" MaxWidth="420"
                MouseLeftButtonUp="Card_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <!-- 한 줄 메시지 -->
                <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" MaxWidth="320"
                           Visibility="Collapsed"/>

                <!-- 입력 -->
                <StackPanel x:Name="InputPanel" Visibility="Collapsed" MinWidth="320">
                    <TextBlock x:Name="InputPrompt" Text="뭐 할 거냥?" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="InputBox" FontSize="13" KeyDown="InputBox_KeyDown" BorderThickness="0,0,0,1"
                             Background="Transparent" Padding="0,4"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" LineHeight="16">
                        예: SHOP 결제 모듈 분석 금요일까지, 급함 #분석  ·  오늘 뭐 해야 해?<LineBreak/>
                        SHOP2-3 완료  ·  SHOP2-3 메모: 내용  ·  로그인 오류 찾아줘
                    </TextBlock>
                </StackPanel>

                <!-- 확인 -->
                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" MinWidth="320">
                    <TextBlock x:Name="ConfirmQuestion" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="프로젝트" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,12,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ConfirmProject" FontSize="12" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="제목" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,12,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ConfirmTitle" FontSize="12" Margin="0,0,0,3" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="마감" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,12,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ConfirmDue" FontSize="12" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="우선순위" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ConfirmPriority" FontSize="12"/>
                        <!-- 말했을 때만 보이는 줄 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="ConfirmStartLabel" Text="시작" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,12,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ConfirmStart" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" x:Name="ConfirmLabelsLabel" Text="라벨" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,12,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ConfirmLabels" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" x:Name="ConfirmCycleLabel" Text="cycle" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,12,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ConfirmCycle" Text="진행 중인 cycle 에 넣기" FontSize="12" Margin="0,3,0,0"/>
                    </Grid>
                    <WrapPanel x:Name="ProjectChoices" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="취소" Style="{StaticResource Flat}" Padding="12,5" Click="Cancel_Click"/>
                        <Button x:Name="ConfirmButton" Content="등록" Style="{StaticResource Primary}" Padding="14,5"
                                Margin="8,0,0,0" Click="Confirm_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 범용 확인: 상태 변경, 댓글, 프로젝트 생성 -->
                <StackPanel x:Name="ActionPanel" Visibility="Collapsed" MinWidth="320">
                    <TextBlock x:Name="ActionQuestion" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Grid x:Name="ActionRows" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="취소" Style="{StaticResource Flat}" Padding="12,5" Click="Cancel_Click"/>
                        <Button x:Name="ActionButton" Style="{StaticResource Primary}" Padding="14,5"
                                Margin="8,0,0,0" Click="Action_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 브리핑 목록 -->
                <StackPanel x:Name="BriefingPanel" Visibility="Collapsed" MinWidth="360">
                    <TextBlock x:Name="BriefingHeadline" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="BriefingProjects" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"
                               TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SectionList" ItemTemplate="{StaticResource SectionTemplate}"/>
                    </ScrollViewer>
                    <TextBlock x:Name="BriefingEmpty" FontSize="12"
                               Foreground="{StaticResource TextMuted}" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 꼬리. 카드 아래쪽, 캐릭터 방향으로 -->
        <Polygon x:Name="Tail" Points="0,0 18,0 14,12" Fill="{StaticResource Surface}"
                 Stroke="{StaticResource Border}" StrokeThickness="1"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,-11"/>
    </Grid>
</Window>
