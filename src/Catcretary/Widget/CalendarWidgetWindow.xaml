<Window x:Class="Catcretary.Widget.CalendarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Catcretary"
        Title="Catcretary 캘린더"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" ShowActivated="False"
        MinWidth="300" MinHeight="240" Width="560" Height="480">

    <!-- 테두리 없는 창의 크기 조절. 고정 모드에서는 코드가 ResizeBorderThickness 를 0 으로 바꾼다. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 테마 색. ApplySettings 가 같은 키로 덮어쓴다. -->
        <SolidColorBrush x:Key="W.Text" Color="#1B1F24"/>
        <SolidColorBrush x:Key="W.Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="W.Grid" Color="#1F000000"/>
        <SolidColorBrush x:Key="W.Sunday" Color="#DC2626"/>
        <SolidColorBrush x:Key="W.Saturday" Color="#2563EB"/>
        <SolidColorBrush x:Key="W.TodayFill" Color="#1F2563EB"/>
        <SolidColorBrush x:Key="W.TodayRing" Color="#2563EB"/>
        <SolidColorBrush x:Key="W.ItemFill" Color="#0F000000"/>
        <SolidColorBrush x:Key="W.Danger" Color="#DC2626"/>

        <!-- 앱 전역 TextBlock 스타일은 글자색이 밝은 테마로 고정돼 있어서 위젯 안에서는 덮어쓴다. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource W.Text}"/>
            <Setter Property="FontFamily" Value="{x:Static local:App.UiFont}"/>
            <!-- Display 는 11px 안팎에서 '트' 의 ㅡ 처럼 붙은 가로획을 한 픽셀로 합쳐 지운다. -->
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource W.Muted}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Nav" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource W.ItemFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" CornerRadius="10" Padding="10,6,10,8" BorderThickness="1"
            BorderBrush="{DynamicResource W.Grid}"
            MouseRightButtonUp="Frame_MouseRightButtonUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 제목 줄. 고정 모드가 아니면 여기를 끌어서 옮긴다. -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LockIcon" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11"
                               Margin="6,2,0,0" ToolTip="위치·크기 고정됨" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource Nav}" Click="Prev_Click" ToolTip="이전 달">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;"/>
                    </Button>
                    <Button x:Name="TodayButton" Style="{StaticResource Nav}" Click="Today_Click" ToolTip="이번 달">
                        <TextBlock Text="오늘" FontSize="12" Foreground="{DynamicResource W.Muted}"/>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource Nav}" Click="Next_Click" ToolTip="다음 달">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;"/>
                    </Button>
                    <Button Style="{StaticResource Nav}" Click="Refresh_Click" ToolTip="Plane 새로고침">
                        <TextBlock x:Name="RefreshIcon" Style="{StaticResource Icon}" Text="&#xE72C;"/>
                    </Button>
                </StackPanel>
            </Grid>

            <UniformGrid x:Name="WeekHeader" Grid.Row="1" Columns="7" Rows="1" Margin="0,6,0,2"/>

            <!-- 한 줄 = 한 주. 주마다 7열 Grid 를 코드로 만든다(기간 막대가 여러 칸에 걸치도록). -->
            <UniformGrid x:Name="DayGrid" Grid.Row="2" Columns="1" SizeChanged="DayGrid_SizeChanged"/>

            <!-- 항목을 끌 때 놓일 날 칸 표시. 마우스는 막지 않는다. -->
            <Canvas x:Name="DragLayer" Grid.Row="2" IsHitTestVisible="False">
                <Border x:Name="DropMarker" Visibility="Collapsed" CornerRadius="5" BorderThickness="1.5"
                        BorderBrush="{DynamicResource W.TodayRing}" Background="{DynamicResource W.TodayFill}"/>
            </Canvas>

            <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="10.5" Margin="2,6,0,0"
                       Foreground="{DynamicResource W.Muted}" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
