<Window x:Class="Catcretary.Board.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Catcretary"
        Title="Catcretary 상태별 보드"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" ShowActivated="False"
        MinWidth="480" MinHeight="300" Width="1180" Height="660">

    <!-- 테두리 없는 창의 크기 조절. 고정 모드에서는 코드가 ResizeBorderThickness 를 0 으로 바꾼다. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 앱 전역 TextBlock 스타일 대신 위젯 테마 색. 색 키는 ApplySettings 가 WidgetPalette 로 채운다. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource W.Text}"/>
            <Setter Property="FontFamily" Value="{x:Static local:App.UiFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <!-- 열·드롭다운 스크롤바를 얇은 테마 스크롤바로. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource W.ScrollBar}"/>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource W.Muted}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Nav" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource W.ItemFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" CornerRadius="10" Padding="10,6,10,8" BorderThickness="1"
            BorderBrush="{DynamicResource W.Grid}"
            MouseRightButtonUp="Frame_MouseRightButtonUp">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 제목 줄. 고정 모드가 아니면 빈 곳을 끌어서 옮긴다. 범위·프로젝트를 바꾸면 바로 config.json 의 board 에 저장한다. -->
            <DockPanel x:Name="Header" Grid.Row="0" Background="Transparent" LastChildFill="False" Margin="0,0,0,8"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="상태별 보드" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LockIcon" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11"
                               Margin="6,2,0,0" ToolTip="위치·크기 고정됨" Visibility="Collapsed"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Nav}" Click="Refresh_Click" ToolTip="Plane 새로고침"
                        Margin="6,0,0,0">
                    <TextBlock x:Name="RefreshIcon" Style="{StaticResource Icon}" Text="&#xE72C;"/>
                </Button>
                <CheckBox x:Name="ClosedCheck" DockPanel.Dock="Right" Style="{StaticResource W.Check}" Content="완료·취소 카드"
                          FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0" Click="ClosedCheck_Click"/>
                <ComboBox x:Name="ProjectBox" DockPanel.Dock="Right" Width="260" Margin="8,0,0,0"
                          SelectionChanged="ProjectBox_SelectionChanged"/>
                <ComboBox x:Name="ScopeBox" DockPanel.Dock="Right" Width="150" Margin="16,0,0,0"
                          SelectionChanged="ScopeBox_SelectionChanged">
                    <ComboBoxItem Content="내 담당" Tag="mine"/>
                    <ComboBoxItem Content="전체 (담당자 무관)" Tag="all"/>
                </ComboBox>
            </DockPanel>

            <!-- 열 = 상태(프로젝트 하나) 또는 상태 그룹(모든 프로젝트). 코드로 만든다. 열 너비는 창 너비에 맞춘다. -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          SizeChanged="Scroller_SizeChanged">
                <StackPanel x:Name="Columns" Orientation="Horizontal"/>
            </ScrollViewer>

            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,6,0,0" FontSize="10.5"
                       Foreground="{DynamicResource W.Muted}" TextTrimming="CharacterEllipsis"/>

            <!-- 끄는 동안 마우스를 따라다니는 카드. 마우스는 막지 않는다. -->
            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                <Border x:Name="Ghost" Visibility="Collapsed" Background="{DynamicResource W.Surface}" BorderBrush="{DynamicResource W.TodayRing}"
                        BorderThickness="1.5" CornerRadius="6" Padding="8,5" MaxWidth="260" Opacity="0.95">
                    <TextBlock x:Name="GhostText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
