<Window x:Class="Catcretary.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Catcretary"
        Title="설정" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Plane 연결" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="서버 주소" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    <TextBox x:Name="BaseUrlBox" Margin="0,4,0,10"/>

                    <TextBlock Text="워크스페이스 slug" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    <TextBox x:Name="WorkspaceBox" Margin="0,4,0,10"/>

                    <TextBlock Text="API 키" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    <PasswordBox x:Name="ApiKeyBox" Margin="0,4,0,10" Padding="6,5"
                                 FontFamily="{x:Static local:App.UiFont}"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestButton" Content="연결 테스트" Style="{StaticResource Flat}" Click="Test_Click"/>
                        <TextBlock x:Name="TestResult" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="브리핑" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="알림 시각" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Width="80"/>
                        <TextBox x:Name="TimeBox" Width="80" ToolTip="HH:mm 형식"/>
                        <CheckBox x:Name="WeekdaysCheck" Content="평일만" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox x:Name="OpenWindowCheck" Content="브리핑 시각에 창까지 연다" Margin="0,12,0,0"/>
                    <CheckBox x:Name="AutoStartCheck" Content="Windows 로그인 시 자동 실행" Margin="0,10,0,0"/>
                    <TextBlock Text="기본 프로젝트 (말로 등록할 때 프로젝트를 말하지 않으면 여기에 넣는다)" FontSize="12"
                               Foreground="{StaticResource TextMuted}" Margin="0,14,0,0"/>
                    <ComboBox x:Name="DefaultProjectBox" Margin="0,4,0,0" IsEditable="True"
                              ToolTip="프로젝트 identifier. 비우면 등록할 때마다 프로젝트를 묻는다"/>

                    <TextBlock Text="제외할 프로젝트 (identifier, 쉼표로 구분)" FontSize="12"
                               Foreground="{StaticResource TextMuted}" Margin="0,14,0,0"/>
                    <TextBox x:Name="ExcludedBox" Margin="0,4,0,0" ToolTip="예: SANDBOX, DEMO"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" Style="{StaticResource Flat}" Width="84" Click="Cancel_Click"/>
            <Button Content="저장" Style="{StaticResource Primary}" Width="84" Margin="8,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
